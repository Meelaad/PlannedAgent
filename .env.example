# .env.example - contains no real credentials.
# Copy this file to .env and put your own values there. .env is in .gitignore; never commit it.

# Which LLM to use: gemini (cloud, free tier) or ollama (local model, no key)
PLANNER_LLM=gemini

# Gemini: create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_LOCAL_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama: install Ollama and run "ollama pull qwen3.5" first
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5

# Location for the rain forecast (default: York University, Toronto)
PLANNER_LAT=43.7735
PLANNER_LON=-79.5019

# Folder for your saved data and the activity log (default: ~/.plannedagent)
# PLANNER_DATA=
