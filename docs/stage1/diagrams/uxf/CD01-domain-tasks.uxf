    <panel_attributes>&lt;&lt;Composite: Leaf&gt;&gt;
&lt;&lt;State: Context&gt;&gt;
Task
--
-id: String
-title: String
-estimatedMinutes: int
-deadline: LocalDateTime
-priority: Priority
-category: String
-outdoor: boolean
-preferredTime: TimeOfDay
-prerequisiteIds: Set&lt;String&gt;
-state: TaskState
--
+schedule(): void
+unschedule(): void
+complete(): void
+markMissed(): void
+reopen(): void
+restoreStatus(status: TaskStatus): void
+needsScheduling(): boolean
+getStatus(): TaskStatus
+addPrerequisite(taskId: String): void
+isOutdoor(): boolean
~changeState(next: TaskState): void</panel_attributes>
