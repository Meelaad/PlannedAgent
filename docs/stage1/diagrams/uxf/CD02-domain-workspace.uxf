    <panel_attributes>&lt;&lt;MVC: Model&gt;&gt;
&lt;&lt;Command: Receiver&gt;&gt;
Workspace
--
-tasks: Map&lt;String, Task&gt;
-goals: Map&lt;String, Goal&gt;
-events: List&lt;CalendarEvent&gt;
-plan: Plan
-settings: UserSettings
--
+getTask(id: String): Task
+addTask(task: Task): void
+removeTask(id: String): void
+tasks(): List&lt;Task&gt;
+tasksNeedingSchedule(): List&lt;Task&gt;
+addGoal(goal: Goal): void
+goals(): List&lt;Goal&gt;
+events(): List&lt;CalendarEvent&gt;
+addEvents(events: List&lt;CalendarEvent&gt;): int
+busyIntervals(range: TimeInterval): List&lt;TimeInterval&gt;
+getPlan(): Plan
+getSettings(): UserSettings
+snapshot(): Workspace</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
