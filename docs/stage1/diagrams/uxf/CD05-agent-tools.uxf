  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>1420</x>
      <y>370</y>
      <w>530</w>
      <h>190</h>
    </coordinates>
    <panel_attributes>&lt;&lt;Template Method: AbstractClass&gt;&gt;
/AbstractTool/
--
+execute(call: ToolCall, context: ToolContext): ToolResult {final}
#validate(args: Map&lt;String, Object&gt;): List&lt;String&gt;
/#doExecute(args: ToolArgs, context: ToolContext): ToolResult/
--
execute(): 1 validate args against spec()
2 if invalid: return failure (tool never runs)
3 doExecute(args, context)
4 exceptions become ToolResult.failure</panel_attributes>
    <additional_attributes></additional_attributes>
