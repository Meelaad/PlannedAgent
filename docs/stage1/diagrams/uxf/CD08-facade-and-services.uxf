  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>1400</x>
      <y>380</y>
      <w>750</w>
      <h>960</h>
    </coordinates>
    <panel_attributes>&lt;&lt;Facade&gt;&gt;
PlannerFacade
--
-workspace: Workspace
-agent: AgentController
-sessions: Map&lt;String, AgentSession&gt;
-pendingProposals: Map&lt;String, PlanProposal&gt;
-scheduler: Scheduler
-strategies: StrategyRegistry
-slotFinder: SlotFinder
-conflictDetector: ConflictDetector
-history: CommandHistory
-commandFactory: PlanCommandFactory
-capture: TaskCaptureService
-goalPlanner: GoalPlanner
-review: ReviewService
-insights: InsightsService
-preferences: PreferenceMemory
-weather: WeatherService
-calendarImporter: CalendarImporter
-planExporter: PlanExporter
-store: WorkspaceStore
-events: EventBus
-clock: Clock
--
+chat(sessionId: String, message: String): AgentResponse
+confirmProposal(proposalId: String): String
+rejectProposal(proposalId: String): void
+captureTasks(text: String): CaptureResult
+saveTasks(drafts: List&lt;TaskDraft&gt;): List&lt;Task&gt;
+addTask(draft: TaskDraft): Task
+updateTask(taskId: String, draft: TaskDraft): Task
+deleteTask(taskId: String): void
+addDependency(taskId: String, prerequisiteId: String): void
+completeTask(taskId: String): void
+listTasks(status: TaskStatus): List&lt;Task&gt;
+importCalendar(file: Path): int
+exportPlan(file: Path, range: TimeInterval): void
+autoSchedule(range: TimeInterval, strategyName: String): PlanProposal
+detectConflicts(range: TimeInterval): List&lt;Conflict&gt;
+weatherWarnings(range: TimeInterval): List&lt;Conflict&gt;
+undo(): Optional&lt;String&gt;
+redo(): Optional&lt;String&gt;
+listPreferences(): List&lt;Preference&gt;
+forgetPreference(id: String): void
+planGoal(text: String, deadline: LocalDate): GoalDraft
+saveGoal(draft: GoalDraft): Goal
+startReview(date: LocalDate): List&lt;ReviewItem&gt;
+submitReview(sessionId: String, outcomes: Map&lt;String, Boolean&gt;, reason: String): AgentResponse
+weeklyReport(weekStart: LocalDate): WeeklyReport
+strategyNames(): List&lt;String&gt;
+subscribe(listener: AgentEventListener): void
+getWorkspace(): Workspace
-sessionFor(sessionId: String): AgentSession
-registerProposal(proposal: PlanProposal): PlanProposal
-buildConstraints(range: TimeInterval): List&lt;SchedulingConstraint&gt;</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
