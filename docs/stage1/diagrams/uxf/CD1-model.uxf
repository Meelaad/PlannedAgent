-id: String
-taskId: String
-start: LocalDateTime
-end: LocalDateTime
--
+moveTo(newStart: LocalDateTime): void
+overlaps(start: LocalDateTime, end: LocalDateTime): boolean</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
