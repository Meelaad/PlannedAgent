  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>290</x>
      <y>115</y>
      <w>280</w>
      <h>310</h>
    </coordinates>
    <panel_attributes>&lt;&lt;State: Context&gt;&gt;
Task
--
-id: String
-title: String
-minutes: int
-deadline: LocalDateTime
-priority: Priority
-outdoor: boolean
-state: TaskState
--
+schedule(): void
+unschedule(): void
+complete(): void
+markMissed(): void
+needsScheduling(): boolean
+getStatus(): String
+setState(state: TaskState): void</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>640</x>
      <y>90</y>
      <w>560</w>
      <h>360</h>
    </coordinates>
    <panel_attributes>&lt;&lt;MVC: Model&gt;&gt;
&lt;&lt;Command: Receiver&gt;&gt;
Workspace
--
-tasks: List&lt;Task&gt;
-events: List&lt;FixedEvent&gt;
-plan: Plan
-preferences: List&lt;Preference&gt;
--
+getTask(id: String): Task
+addTask(task: Task): void
+removeTask(id: String): void
+getTasks(): List&lt;Task&gt;
+addEvent(event: FixedEvent): void
+getEvents(): List&lt;FixedEvent&gt;
+tasksToSchedule(): List&lt;Task&gt;
+busyBetween(from: LocalDateTime, to: LocalDateTime): List&lt;TimeBlock&gt;
+getPlan(): Plan
+addPreference(preference: Preference): void
+getPreferences(): List&lt;Preference&gt;
+copy(): Workspace</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>1270</x>
      <y>200</y>
      <w>350</w>
      <h>140</h>
    </coordinates>
    <panel_attributes>Plan
--
-blocks: List&lt;TimeBlock&gt;
--
+add(block: TimeBlock): void
+remove(blockId: String): TimeBlock
+find(blockId: String): TimeBlock
+blocksOn(day: LocalDate): List&lt;TimeBlock&gt;</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
