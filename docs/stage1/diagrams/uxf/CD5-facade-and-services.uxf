    <panel_attributes>&lt;&lt;Facade&gt;&gt;
PlannerFacade
--
-workspace: Workspace
-agent: Agent
-scheduler: Scheduler
-checker: ConflictChecker
-history: CommandHistory
-extractor: TaskExtractor
-weather: WeatherService
-reports: ReportService
-exporter: CalendarExporter
-storage: JsonStorage
-events: EventBus
-pending: Proposal
--
+PlannerFacade(workspace: Workspace, llm: LlmClient, storage: JsonStorage)
+tasksFromText(text: String): List&lt;Task&gt;
+saveTasks(tasks: List&lt;Task&gt;): void
+addTask(task: Task): void
+updateTask(task: Task): void
+deleteTask(taskId: String): void
+completeTask(taskId: String): void
+addEvent(event: FixedEvent): void
+exportCalendar(file: Path): void
+autoSchedule(strategyName: String): Proposal
+chat(message: String): AgentReply
+applyProposal(): String
+discardProposal(): void
+checkConflicts(): List&lt;Conflict&gt;
+undo(): boolean
+redo(): boolean
+reviewDay(done: List&lt;String&gt;, missed: List&lt;String&gt;): AgentReply
+weeklyReport(): WeeklyReport
+subscribe(observer: PlannerObserver): void
+getWorkspace(): Workspace
-strategyFor(name: String): SchedulingStrategy
-changed(message: String): void</panel_attributes>
    <additional_attributes></additional_attributes>
