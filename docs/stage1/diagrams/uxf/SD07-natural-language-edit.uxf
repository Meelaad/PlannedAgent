    <panel_attributes>title=SD07 - Edit the plan in natural language (F07 / UC07 - Template Method in action)
obj=Student~s ACTOR
obj=:ChatController~cc
obj=:PlannerFacade~f
obj=:AgentController~ag
obj=:ToolRegistry~tr
