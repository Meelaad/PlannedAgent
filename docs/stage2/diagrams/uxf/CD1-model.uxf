  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>410</x>
      <y>90</y>
      <w>480</w>
      <h>490</h>
    </coordinates>
    <panel_attributes>&lt;&lt;State: Context&gt;&gt;
Task
--
_+MIN_MINUTES: int = 5_
_+MAX_MINUTES: int = 600_
-id: String
-title: String
-minutes: int
-deadline: LocalDateTime
-priority: Priority
-outdoor: boolean
-state: TaskState
-doneAt: LocalDateTime
-missedAt: LocalDateTime
--
+Task(title: String, minutes: int, deadline: LocalDateTime,
     priority: Priority, outdoor: boolean)
+schedule(): void
+unschedule(): void
+complete(): void
+markMissed(): void
+needsScheduling(): boolean
+getStatus(): String
+getState(): TaskState
+setState(state: TaskState): void
+problems(now: LocalDateTime): List&lt;String&gt;
+copy(): Task
--
plus a getter and a setter for each field</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>960</x>
      <y>135</y>
      <w>560</w>
      <h>400</h>
    </coordinates>
    <panel_attributes>&lt;&lt;MVC: Model&gt;&gt;
&lt;&lt;Command: Receiver&gt;&gt;
Workspace
--
-tasks: List&lt;Task&gt;
-events: List&lt;FixedEvent&gt;
-plan: Plan
-preferences: List&lt;Preference&gt;
-lastId: int
--
+getTask(id: String): Task
+addTask(task: Task): void
+removeTask(id: String): void
+getTasks(): List&lt;Task&gt;
+addEvent(event: FixedEvent): void
+getEvents(): List&lt;FixedEvent&gt;
+tasksToSchedule(): List&lt;Task&gt;
+busyBetween(from: LocalDateTime, to: LocalDateTime): List&lt;TimeBlock&gt;
+getPlan(): Plan
+addPreference(preference: Preference): void
+getPreferences(): List&lt;Preference&gt;
+newId(prefix: String): String
+copy(): Workspace</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
