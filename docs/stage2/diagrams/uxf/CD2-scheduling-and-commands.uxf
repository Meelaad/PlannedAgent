    <panel_attributes>&lt;&lt;utility&gt;&gt;
SchedulingStrategies
--
_+NAMES: List&lt;String&gt;_
--
_+byName(name: String): SchedulingStrategy_
--
deadline, priority or shortest;
null for an unknown name</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>430</x>
      <y>90</y>
      <w>510</w>
      <h>300</h>
    </coordinates>
    <panel_attributes>&lt;&lt;Strategy: Context&gt;&gt;
Scheduler
--
-strategy: SchedulingStrategy
_~STEP_MINUTES: int = 30_
_~DAY_START: LocalTime = 08:00_
_~DAY_END: LocalTime = 22:00_
--
+setStrategy(strategy: SchedulingStrategy): void
+getStrategy(): SchedulingStrategy
+schedule(workspace: Workspace, from: LocalDateTime,
     to: LocalDateTime, forecast: Forecast): ScheduleResult
-findStart(task: Task, first: LocalDateTime, to: LocalDateTime,
     work: Workspace, forecast: Forecast): LocalDateTime
-fits(task: Task, start: LocalDateTime, workspace: Workspace,
     forecast: Forecast): boolean
--
works on a copy of the workspace</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>1010</x>
      <y>130</y>
      <w>580</w>
      <h>220</h>
    </coordinates>
    <panel_attributes>ScheduleResult
--
-placed: List&lt;TimeBlock&gt;
-notPlaced: Map&lt;String, String&gt;
--
+ScheduleResult(placed: List&lt;TimeBlock&gt;, notPlaced: Map&lt;String, String&gt;)
+getPlaced(): List&lt;TimeBlock&gt;
+getNotPlaced(): Map&lt;String, String&gt;
+toProposal(heading: String, workspace: Workspace,
     checker: ConflictChecker, forecast: Forecast,
     warnings: List&lt;String&gt;): Proposal
--
one AddBlockCommand per placed block</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>1660</x>
      <y>145</y>
      <w>540</w>
      <h>190</h>
    </coordinates>
    <panel_attributes>ConflictChecker
--
+check(workspace: Workspace, forecast: Forecast): List&lt;Conflict&gt;
+checkChanges(workspace: Workspace, commands: List&lt;PlanCommand&gt;,
     forecast: Forecast): List&lt;Conflict&gt;
-findOverlaps(workspace: Workspace, conflicts: List&lt;Conflict&gt;): void
--
finds overlaps, blocks after a deadline,
outdoor blocks in rain, broken preferences;
checkChanges runs the commands on a copy
and returns only the new conflicts</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
