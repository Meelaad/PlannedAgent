    <panel_attributes>&lt;&lt;interface&gt;&gt;
&lt;&lt;Command: Command&gt;&gt;
PlanCommand
--
+execute(workspace: Workspace): void
+undo(workspace: Workspace): void
+describe(): String</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>2740</x>
      <y>490</y>
      <w>520</w>
      <h>300</h>
    </coordinates>
    <panel_attributes>&lt;&lt;Command: Invoker&gt;&gt;
CommandHistory
--
_~LIMIT: int = 20_
-undoStack: Deque&lt;List&lt;PlanCommand&gt;&gt;
-redoStack: Deque&lt;List&lt;PlanCommand&gt;&gt;
--
+run(commands: List&lt;PlanCommand&gt;, workspace: Workspace): void
+undo(workspace: Workspace): boolean
+redo(workspace: Workspace): boolean
+canUndo(): boolean
+canRedo(): boolean
_-executeAll(group: List&lt;PlanCommand&gt;, workspace: Workspace): void_
_-undoAll(group: List&lt;PlanCommand&gt;, workspace: Workspace): void_
--
a group is all or nothing;
a step that can no longer be
undone is dropped and reported</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
