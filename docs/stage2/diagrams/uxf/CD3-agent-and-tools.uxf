-tools: Map&lt;String, Tool&gt;
-memory: ConversationMemory
-events: EventBus
-clock: Clock
-maxSteps: int = 6
--
+Agent(llm: LlmClient, tools: List&lt;Tool&gt;, memory: ConversationMemory,
     events: EventBus, clock: Clock)
