    <panel_attributes>&lt;&lt;Swing JPanel, Scrollable&gt;&gt;
WeekView
--
-clock: Clock
-highlighted: Set&lt;String&gt;
--
~WeekView(clock: Clock)
~show(plan: Plan, events: List&lt;FixedEvent&gt;, tasks: List&lt;Task&gt;): void
~highlight(ids: Set&lt;String&gt;): void
#paintComponent(graphics: Graphics): void
--
draws the 7 days; blocks in a
conflict are drawn in red</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>640</x>
      <y>145</y>
      <w>580</w>
      <h>460</h>
    </coordinates>
    <panel_attributes>&lt;&lt;MVC: View&gt;&gt;
&lt;&lt;Swing JFrame&gt;&gt;
MainWindow
--
-tasksPanel: JPanel
-weekPanel: JPanel
-chatPanel: JPanel
-taskModel: TaskTableModel
-weekView: WeekView
-controller: MainController
--
+MainWindow()
~bind(controller: MainController): void
+showWindow(): void
+showTasks(tasks: List&lt;Task&gt;): void
+showWeek(plan: Plan, events: List&lt;FixedEvent&gt;, tasks: List&lt;Task&gt;): void
+showChat(text: String): void
+showProposal(proposal: Proposal): void
+showConflicts(conflicts: List&lt;Conflict&gt;): void
+showReport(report: WeeklyReport): void
+showError(message: String): void
~showStatus(text: String): void
~showAgentStatus(text: String): void
~setBusy(busy: boolean, message: String): void
~reviewExtractedTasks(tasks: List&lt;Task&gt;, now: LocalDateTime): List&lt;Task&gt;
~askReview(items: List&lt;ReviewDialog.Item&gt;): ReviewDialog.Result
~confirm(message: String, title: String): boolean</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>1300</x>
