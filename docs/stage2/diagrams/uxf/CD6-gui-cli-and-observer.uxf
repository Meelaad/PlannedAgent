      <w>470</w>
      <h>570</h>
    </coordinates>
    <panel_attributes>&lt;&lt;MVC: Controller&gt;&gt;
&lt;&lt;Observer: ConcreteObserver&gt;&gt;
MainController
--
-facade: PlannerFacade
-window: MainWindow
--
+MainController(facade: PlannerFacade, window: MainWindow)
+onAddText(text: String): void
+onSaveTasks(tasks: List&lt;Task&gt;): void
+onAddTask(task: Task): void
+onEditTask(task: Task): void
+onDeleteTask(taskId: String): void
+onComplete(taskId: String): void
+onAddEvent(event: FixedEvent): void
+onAutoSchedule(strategyName: String): void
+onCheckConflicts(): void
+onSend(message: String): void
+onApply(): void
+onDiscard(): void
+onUndo(): void
+onRedo(): void
+onReviewToday(): void
+onReview(done: List&lt;String&gt;, missed: List&lt;String&gt;): void
+onReport(): void
+onExport(file: Path): void
+update(type: String, message: String): void
-refresh(): void
-safely(action: Runnable): void
-background(busyMessage: String, work: Supplier&lt;T&gt;,
     onDone: Consumer&lt;T&gt;): void
--
slow calls (LLM, weather) run in a
SwingWorker so the window does not freeze</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
