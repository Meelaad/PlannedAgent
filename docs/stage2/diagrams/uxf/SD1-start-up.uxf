<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
  <zoom_level>10</zoom_level>
  <element>
    <id>UMLSequenceAllInOne</id>
    <coordinates>
      <x>20</x>
      <y>20</y>
      <w>1870</w>
      <h>1200</h>
    </coordinates>
    <panel_attributes>title=SD1 - Start-up: settings, choosing the LLM and connecting the objects (Adapter, Facade, Observer) - as implemented
obj=:App~app
obj=:Config~cfg
obj=:JsonStorage~st
obj=:GeminiClient~gem
obj=:OllamaClient~oll
obj=:PlannerFacade~f
obj=:EventBus~eb
obj=:ActivityLog~log
obj=:MainWindow~w
obj=:MainController~c
obj=:PlannerCli~cli
app-&gt;&gt;&gt;cfg : load(".env")
cfg.&gt;app : settings (env variables win)
app-&gt;&gt;&gt;st : JsonStorage(dataDir/workspace.json)
app-&gt;&gt;&gt;st : load()
st.&gt;app : workspace, or an empty one on first run
app-&gt;&gt;&gt;cfg : getDouble("PLANNER_LAT", fallback)
app-&gt;&gt;&gt;app + : createLlm(config)
combinedFragment=alt~a1 app oll
app:[PLANNER_LLM is gemini and GEMINI_API_KEY is set]
app-&gt;&gt;&gt;gem : GeminiClient(apiKey, model)
..=a1
app:[PLANNER_LLM is ollama, the local Qwen model]
app-&gt;&gt;&gt;oll : OllamaClient(baseUrl, model)
..=a1
app:[no key, or an unknown PLANNER_LLM - the app still runs, every AI call fails with a hint]
app-&gt;&gt;&gt;app + : unavailable(reason)
--=a1
app-&gt;&gt;&gt;f : PlannerFacade(workspace, llm, storage, new OpenMeteoWeather(lat, lon), clock)
f-&gt;&gt;&gt;st : loadHistory()
st.&gt;f : CommandHistory with the saved undo steps
app-&gt;&gt;&gt;log : ActivityLog(dataDir/activity.log)
app-&gt;&gt;&gt;f : subscribe(log)
f-&gt;&gt;&gt;eb : attach(observer)
combinedFragment=alt~a2 app cli
app:[no command-line arguments - start the GUI]
app-&gt;&gt;&gt;w : MainWindow()
app-&gt;&gt;&gt;c : MainController(facade, window)
c-&gt;&gt;&gt;w : bind(controller)
c-&gt;&gt;&gt;c + : refresh()
app-&gt;&gt;&gt;f : subscribe(controller)
f-&gt;&gt;&gt;eb : attach(observer)
app-&gt;&gt;&gt;w : showWindow()
..=a2
app:[arguments given, or no screen - run the CLI]
app-&gt;&gt;&gt;cli : PlannerCli(facade)
app-&gt;&gt;&gt;cli : run(args)
--=a2</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
</diagram>
