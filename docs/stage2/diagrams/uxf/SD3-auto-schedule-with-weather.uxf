    </coordinates>
    <panel_attributes>title=SD3 - Auto-schedule with a strategy, the weather and preferences (F04, F08, F09 / UC04, UC08) - as implemented
obj=Student~s ACTOR
obj=:MainWindow~w
obj=:MainController~c
obj=:PlannerFacade~f
obj=weather:OpenMeteoWeather~we
obj=:Scheduler~sch
obj=strategy:DeadlineFirstStrategy~st
obj=:Workspace~ws
obj=result:ScheduleResult~r
obj=:ConflictChecker~cc
obj=:EventBus~eb
s-&gt;&gt;&gt;w : choose deadline and click Auto-schedule
w-&gt;&gt;&gt;c : onAutoSchedule("deadline")
c-&gt;&gt;&gt;f : autoSchedule("deadline") - in a SwingWorker
f-&gt;&gt;&gt;f + : strategyFor("deadline", warnings)
f-&gt;&gt;&gt;f + : forecast(now, now + 7 days)
f-&gt;&gt;&gt;we : forecast(from, to)
combinedFragment=alt~a1 f we
f:[forecast received]
we.&gt;f : Forecast, rain chance per hour
..=a1
f:[Open-Meteo not reachable]
we.&gt;f : IOException
f-&gt;&gt;&gt;f + : Forecast.none() + a warning
--=a1
f-&gt;&gt;&gt;sch : setStrategy(strategy)
f-&gt;&gt;&gt;sch : schedule(workspace, now, until, forecast)
sch-&gt;&gt;&gt;ws : copy()
ws.&gt;sch : a work copy - the real plan is not changed
sch-&gt;&gt;&gt;ws : tasksToSchedule()
ws.&gt;sch : tasks in the To-do or Missed state
sch-&gt;&gt;&gt;st : sort(tasks)
st.&gt;sch : tasks in deadline order
combinedFragment=loop~l1 sch ws
sch:[each task, each 30-minute start between 08:00 and 22:00 until fits() passes: deadline, preferences, rain, busyBetween()]
sch-&gt;&gt;&gt;sch + : fits(task, start, work, forecast)
--=l1
sch-&gt;&gt;&gt;r : ScheduleResult(placed, notPlaced)
sch.&gt;f : result
f-&gt;&gt;&gt;r : toProposal(heading, workspace, checker, forecast, warnings)
r-&gt;&gt;&gt;r + : one AddBlockCommand per placed block
r-&gt;&gt;&gt;cc : checkChanges(workspace, commands, forecast)
cc-&gt;&gt;&gt;cc + : check() before and after
cc.&gt;r : only the new conflicts
r.&gt;f : Proposal with the summary, the commands and the conflicts
f-&gt;&gt;&gt;f + : setPending(proposal)
f-&gt;&gt;&gt;eb : notifyObservers("PROPOSAL", "4 changes waiting")
f.&gt;c : proposal
c-&gt;&gt;&gt;w : showProposal(proposal)
ref=s c : SD5 - apply or discard the proposal</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
</diagram>
