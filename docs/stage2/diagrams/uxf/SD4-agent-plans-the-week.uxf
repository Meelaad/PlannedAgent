<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
  <zoom_level>10</zoom_level>
  <element>
    <id>UMLSequenceAllInOne</id>
    <coordinates>
      <x>20</x>
      <y>20</y>
      <w>1530</w>
      <h>1200</h>
    </coordinates>
    <panel_attributes>title=SD4 - The agent plans the week (F05 / UC05 - agent loop with tools and memory) - as implemented
obj=Student~s ACTOR
obj=:MainWindow~w
obj=:MainController~c
obj=:PlannerFacade~f
obj=:Agent~a
obj=:ConversationMemory~m
obj=llm:LlmClient~llm
obj=tool:Tool~t
obj=:EventBus~eb
s-&gt;&gt;&gt;w : Plan my week, gym twice, groceries
w-&gt;&gt;&gt;c : onSend(message)
c-&gt;&gt;&gt;w : showChat("You: " + message)
c-&gt;&gt;&gt;f : chat(message) - in a SwingWorker
f-&gt;&gt;&gt;a : handle(message, workspace)
a-&gt;&gt;&gt;m : add("user", message)
combinedFragment=loop~l1 a eb
a:[at most 6 steps, until the LLM gives a final answer]
a-&gt;&gt;&gt;a + : buildRequest(workspace)
tick=1
a-&gt;&gt;&gt;m : recent()
a-&gt;&gt;&gt;llm : complete(request)
llm.&gt;a : one JSON object
a-&gt;&gt;&gt;a + : parseStep(text)
tick=1
combinedFragment=alt~a1 a eb
a:[a tool call, e.g. get_tasks, get_schedule, schedule_tasks]
a-&gt;&gt;&gt;m : add("agent", the call as JSON)
a-&gt;&gt;&gt;eb : notifyObservers("AGENT", "using schedule_tasks")
a-&gt;&gt;&gt;a + : runTool(step, workspace)
tick=1
a-&gt;&gt;&gt;t : run(args, workspace)
t.&gt;a : ToolResult, may hold a Proposal
a-&gt;&gt;&gt;m : add("tool", result or error text)
..=a1
a:[not valid JSON]
a-&gt;&gt;&gt;m : add("system", format reminder)
..=a1
a:[the final answer]
a-&gt;&gt;&gt;m : add("agent", answer)
--=a1
--=l1
combinedFragment=alt~a2 f a
f:[answer ready]
a.&gt;f : AgentReply with the text and the last proposal
f-&gt;&gt;&gt;f + : setPending(proposal)
tick=1
..=a2
f:[6 steps used]
a.&gt;f : AgentReply("I could not finish...")
..=a2
f:[LlmException - the AI is not available]
a.&gt;f : LlmException
f-&gt;&gt;&gt;f + : reply: the AI is not available
tick=1
--=a2
f.&gt;c : reply
c-&gt;&gt;&gt;w : showChat("Agent: " + text)
c-&gt;&gt;&gt;w : showProposal(proposal)
ref=s c : SD5 - apply or discard the proposal</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
</diagram>
